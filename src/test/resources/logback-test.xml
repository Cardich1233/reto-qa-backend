<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{15} - %msg%n</pattern>
    </encoder>
  </appender>

  <appender name="ARCHIVO" class="ch.qos.logback.core.FileAppender">
    <file>target/karate.log</file>
    <append>false</append>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{15} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Peticiones y respuestas HTTP completas en el log y en el reporte -->
  <logger name="com.intuit.karate" level="DEBUG"/>

  <root level="WARN">
    <appender-ref ref="CONSOLA"/>
    <appender-ref ref="ARCHIVO"/>
  </root>

</configuration>
